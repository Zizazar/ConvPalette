{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConvPalette",
  "version": "0.1.0",
  "identifier": "com.convpalette.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ConvPalette",
        "width": 680,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ConvPalette",
    "shortDescription": "Палитра-конвертер файлов на базе ffmpeg",
    "longDescription": "Всплывающая палитра-конвертер файлов для Windows: умные рекомендации форматов, запросы к ИИ на естественном языке, выполнение ffmpeg с прогрессом.",
    "copyright": "© 2026 ConvPalette",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
